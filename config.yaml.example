# AI-Connect configuration
# ./install.sh writes this file. To set it up by hand, copy it to
# ~/.config/ai-connect/config.yaml and adjust it. All keys are required.

bridge:
  # On the Bridge machine: listen address (0.0.0.0 = reachable from the network).
  # On every other machine: IP or hostname of the Bridge machine.
  host: "0.0.0.0"
  port: 9999
  # Bridge machine only: messages older than this many days are deleted
  # from the history, at start and then daily
  history_days: 180
  # Shared secret: the Bridge refuses every connection without it. The
  # same value on every machine; generate one with: openssl rand -hex 32
  token: "replace-with-a-long-random-string"
  # Bridge machine only: SHA-256 of the observer token, which lets a tool
  # read all traffic (observer_client). The token itself is not in this file,
  # which every agent reads, but in ~/.config/ai-connect/observer.token.
  # installer.py observer-token writes both; "" on other machines.
  observer_token_sha256: ""
  # Bridge machine only: SHA-256 of the user token, with which a person
  # writes to agents as User:<name> (the send command, Agent-Orc). The token
  # is stored nowhere on this machine: installer.py user-token shows it
  # once; keep it in your password manager. "" = nobody can send as user.
  user_token_sha256: ""

peer:
  # Name of this machine's HTTP/SSE server in the network. The STDIO client
  # (Claude Code) names itself "Hostname:Project" instead, e.g.
  # Mini:AIfred-Intelligence. AI_CONNECT_PEER_NAME overrides both.
  name: "my-machine"

mcp:
  # Address of the local HTTP/SSE server for MCP clients
  host: "127.0.0.1"
  port: 9998

logging:
  # Log files of the MCP clients are rotated at this size; this many old
  # files are kept per log
  max_megabytes: 5
  backup_count: 3
